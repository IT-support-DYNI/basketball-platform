/*
 * Data model at a glance (see ARCHITECTURE.md §2 for the full ERD + rationale):
 *   User             — every account (ADMIN/COACH/PLAYER), auth lives here
 *   CoachProfile     — 1:1 extension of a COACH user
 *   PlayerProfile    — 1:1 extension of a PLAYER user; belongs to one Team
 *   Team             — roster + owning entity for sessions/videos/announcements
 *   TeamCoach        — many-to-many: a team can have several coaches, a
 *                       coach can manage several teams
 *   TrainingSession  — created/managed by a coach, scoped to a team
 *   AttendanceRecord — one row per (session, player)
 *   Video            — uploaded by a coach/admin, assigned via VideoAssignment
 *   PerformanceEvaluation — weekly/monthly, one per (player, coach, period)
 *   PerformanceCategoryScore — one row per scored category per evaluation
 *   Feedback         — written note, optionally tied to a session or evaluation
 *   Notification     — in-app only for MVP
 *   Announcement     — platform-wide (admin) or team-scoped (coach/admin)
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used for normal queries — point this at your
  // provider's pooled connection string in production (e.g. Neon).
  url       = env("DATABASE_URL")
  // Unpooled connection, used only for running migrations.
  directUrl = env("DIRECT_URL")
}

// ENUMS

enum UserRole {
  ADMIN
  COACH
  PLAYER
  /// Parent/guardian of one or more players — DYNI Blazers PRD §25.
  /// Manages linked child accounts via GuardianRelationship.
  GUARDIAN
}

/// Self-service registration lifecycle — DYNI Blazers PRD §6 (Journey A).
/// Every account created by an Admin/Coach directly (the original
/// basketball-platform flow) is APPROVED immediately; this only gates
/// accounts that came through public self-registration.
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum PlayerPosition {
  PG
  SG
  SF
  PF
  C
}

/// A player's status within a team for a season (brief §8).
enum MembershipStatus {
  PENDING
  ACTIVE
  INJURED
  SUSPENDED
  INACTIVE
  TRIALIST
  FORMER
}

/// A staff member's role on a team (brief §8: "assign coaches and managers").
enum StaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  TEAM_MANAGER
  STATISTICIAN
  MEDICAL_OFFICER
  WELFARE_OFFICER
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum VideoCategory {
  SHOOTING
  BALL_HANDLING
  DEFENSE
  PASSING
  FINISHING
  FITNESS
  FOOTWORK
  CONDITIONING
  GAME_ANALYSIS
  OTHER
}

enum EvaluationPeriod {
  WEEKLY
  MONTHLY
}

enum PerformanceCategory {
  SHOOTING
  DEFENSE
  PASSING
  BALL_HANDLING
  FITNESS
  TEAMWORK
  EFFORT
  DISCIPLINE
}

enum NotificationType {
  TRAINING_CHANGE
  NEW_VIDEO
  NEW_EVALUATION
  NEW_FEEDBACK
  ANNOUNCEMENT
  REGISTRATION_UPDATE
}

enum AnnouncementScope {
  PLATFORM
  TEAM
}

// CLUB & SEASON
// DYNI Blazers PRD §5 — "design the database as a multi-tenant platform...
// support organisations or clubs, multiple seasons." One Club row exists
// today (DYNI Blazers); Team belongs to a Club so a second club is additive,
// not a migration. Season is real but not yet used to scope team membership
// (jerseyNumber/position/status still live on PlayerProfile directly, same
// as before this pass) — that season-scoped-membership refactor is flagged
// as follow-up work, not done in this pass, to avoid destabilizing every
// feature already built on the current PlayerProfile.teamId shape.

model Club {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String?
  /// Age (in years) at/under which a player must register through a
  /// guardian rather than themselves — a legal/policy input, not something
  /// engineering can safely default without the club's own confirmation.
  /// See docs' Document 6 §19.6 in the dyni-blazers project for why this
  /// isn't hardcoded.
  minorAgeThreshold  Int      @default(18)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  teams   Team[]
  seasons Season[]
}

model Season {
  id        Int      @id @default(autoincrement())
  clubId    Int
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  squads           Squad[]
  memberships      TeamMembership[]
  staffAssignments StaffAssignment[]

  @@index([clubId, isActive])
}

// ORGANISATION — squads, season-scoped memberships, staff assignments (brief §5, §8).

/// A roster grouping within a team for a season (e.g. "Senior A", "U16 B").
/// Optional layer — a team with a single squad per season is fine.
model Squad {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonId  Int
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name      String
  ageGroup  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships TeamMembership[]

  @@unique([teamId, seasonId, name])
  @@index([seasonId])
}

/// A player's membership of a team for one season. Jersey number, position and
/// status live here, never on PlayerProfile (brief §5). A player can have many
/// memberships across seasons/teams — the historical record.
model TeamMembership {
  id                Int              @id @default(autoincrement())
  playerProfileId   Int
  player            PlayerProfile    @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  teamId            Int
  team              Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonId          Int
  season            Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  squadId           Int?
  squad             Squad?           @relation(fields: [squadId], references: [id], onDelete: SetNull)
  jerseyNumber      Int?
  position          PlayerPosition?
  secondaryPosition PlayerPosition?
  status            MembershipStatus @default(ACTIVE)
  joinedAt          DateTime         @default(now())
  leftAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // One membership per player per team per season.
  @@unique([playerProfileId, teamId, seasonId])
  @@index([teamId, seasonId])
  @@index([seasonId, status])
  // The "no two active players share a jersey in the same team+season" rule is a
  // partial unique index (status = ACTIVE AND jerseyNumber IS NOT NULL), added
  // by raw SQL in the migration — Prisma can't express a filtered unique index.
}

/// A staff member assigned to a team, optionally for a specific season.
/// Supersedes TeamCoach; TeamCoach stays authoritative until its readers are
/// migrated (W4 part 2).
model StaffAssignment {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seasonId  Int?
  season    Season?   @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  role      StaffRole
  createdAt DateTime  @default(now())

  @@unique([userId, teamId, role, seasonId])
  @@index([teamId])
}

// AUDIT LOG
// DYNI Blazers PRD §31 — append-only record of sensitive actions. Starting
// with registration decisions (the first thing that needs one); extended to
// other sensitive actions incrementally rather than wired into everything
// at once.

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorUserId Int?
  actor      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   Int?
  /// Free-form context (previous/new value, reason, etc.) — kept as JSON
  /// rather than a fixed column set since different actions carry different
  /// shapes of "what changed."
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

// AUTH — email verification, password reset, brute-force protection (brief §32).

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use, expiring token for email verification and password reset. Only
/// the SHA-256 hash is stored — the raw token exists solely in the emailed link,
/// so a database read can't be used to take over an account.
model AuthToken {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

/// One row per sign-in attempt, for rate limiting / account lockout. `email` is
/// whatever was submitted (may not be a real account); `ipHash` is hashed so the
/// table isn't a plaintext IP log.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ipHash    String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// A signed-in device/browser. The JWT carries `tokenId`; the session is
/// revoked (from another device, or on password reset) by setting `revokedAt`,
/// which the jwt callback checks on every request. This is what makes an
/// otherwise-stateless JWT session revocable (brief §32: session revocation).
model AuthSession {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId    String    @unique
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

/// TOTP multi-factor auth. Mandatory for administrators (Doc 6 §19.5),
/// optional for everyone else. `secret` is the base32 TOTP seed; the managed
/// database is encrypted at rest, and a column-level encryption pass is a
/// follow-up if club policy requires it. `recoveryCodes` are bcrypt hashes,
/// each removed as it is used.
model UserMfa {
  userId        Int       @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret        String
  enabledAt     DateTime?
  recoveryCodes String[]
  createdAt     DateTime  @default(now())
}

// USERS

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole
  isActive     Boolean  @default(true)
  /// Set when Admin/Coach provisions this account with a temporary
  /// password (ARCHITECTURE.md §6.1 — no public self-registration).
  /// Cleared once the user sets their own password.
  mustChangePassword Boolean @default(false)
  /// Set when the user confirms their email via the verification link
  /// (brief §6, Journey A). Null = unverified. Admin/Coach-provisioned
  /// accounts are seeded verified; self-registrations must verify before an
  /// administrator can approve them.
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coachProfile  CoachProfile?
  playerProfile PlayerProfile?

  uploadedVideos Video[]        @relation("VideoUploader")
  notifications  Notification[]
  announcements  Announcement[] @relation("AnnouncementAuthor")
  pushSubscriptions PushSubscription[]
  authTokens    AuthToken[]
  authSessions  AuthSession[]
  mfa           UserMfa?
  staffAssignments StaffAssignment[]
  auditLogsActed AuditLog[]
  /// Populated when role = GUARDIAN — the player(s) this user manages.
  guardianOf     GuardianRelationship[] @relation("Guardian")
  /// Populated when role = ADMIN and this admin has reviewed at least one registration.
  registrationsReviewed PlayerProfile[] @relation("RegistrationReviewer")
}

// WEB PUSH

/// One row per browser/device a user has enabled push on. A user can have
/// several (phone + laptop, etc.) — endpoint is the dedupe/delete key.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// COACH

model CoachProfile {
  id      Int     @id @default(autoincrement())
  userId  Int     @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone   String?
  bio     String?

  sessionsCreated      TrainingSession[]        @relation("SessionCreatedBy")
  attendanceRecorded   AttendanceRecord[]       @relation("AttendanceRecordedBy")
  evaluationsGiven     PerformanceEvaluation[]  @relation("EvaluationCoach")
  feedbackGiven        Feedback[]               @relation("FeedbackCoach")
}

// PLAYER

model PlayerProfile {
  id              Int            @id @default(autoincrement())
  userId          Int            @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl        String?
  dateOfBirth     DateTime?
  /// Visible only to Admin and the player's own coach(es) — see ARCHITECTURE.md §6.4.
  contactPhone    String?
  /// Visible only to Admin and the player's own coach(es) — see ARCHITECTURE.md §6.4.
  guardianName    String?
  /// Visible only to Admin and the player's own coach(es) — see ARCHITECTURE.md §6.4.
  guardianContact String?

  /// The team + position the applicant asked for at sign-up. Advisory only —
  /// the admin confirms the team and a coach assigns the jersey at approval,
  /// which creates the authoritative TeamMembership.
  registrationTeamId     Int?
  registrationTeam       Team?          @relation("RegistrationApplicant", fields: [registrationTeamId], references: [id], onDelete: SetNull)
  registrationPosition   PlayerPosition?

  /// Self-service registration lifecycle (DYNI Blazers PRD §6). Defaults to
  /// APPROVED so every existing/admin-created player is unaffected — this
  /// only gates accounts that come through the new public /register flow.
  registrationStatus     RegistrationStatus @default(APPROVED)
  /// Admin's reason for a REJECTED or CHANGES_REQUESTED decision — shown
  /// back to the applicant on their status page.
  registrationReviewNote String?
  registrationReviewedByUserId Int?
  registrationReviewedBy User?         @relation("RegistrationReviewer", fields: [registrationReviewedByUserId], references: [id], onDelete: SetNull)
  registrationSubmittedAt DateTime?
  registrationReviewedAt  DateTime?
  /// Basic consent — a single acceptance timestamp for the club's
  /// registration terms, captured at sign-up. Full versioned/multi-document
  /// consent management (DYNI Blazers PRD §24) is a later increment; this
  /// is the Phase-1-basics slice the roadmap calls for.
  consentAcceptedAt DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  attendanceRecords AttendanceRecord[]
  evaluations       PerformanceEvaluation[]
  feedback          Feedback[]
  videoAssignments  VideoAssignment[]
  guardians         GuardianRelationship[] @relation("Player")
  memberships       TeamMembership[]

  @@index([registrationStatus])
}

// GUARDIANS
// DYNI Blazers PRD §25 — a guardian may manage one or more child accounts.

model GuardianRelationship {
  id              Int           @id @default(autoincrement())
  guardianUserId  Int
  guardian        User          @relation("Guardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  playerProfileId Int
  player          PlayerProfile @relation("Player", fields: [playerProfileId], references: [id], onDelete: Cascade)
  /// e.g. "Parent", "Legal guardian" — free text, clubs vary in how they describe this.
  relationshipLabel String
  createdAt       DateTime      @default(now())

  @@unique([guardianUserId, playerProfileId])
  @@index([playerProfileId])
}

// TEAM

model Team {
  id          Int        @id @default(autoincrement())
  /// Nullable so this migration doesn't need to backfill every existing
  /// team in a live database with a default club — new teams should set
  /// it, existing ones are treated as belonging to the platform's implicit
  /// single club until explicitly assigned. See Club's own comment.
  clubId      Int?
  club        Club?      @relation(fields: [clubId], references: [id], onDelete: SetNull)
  name        String
  description String?
  ageGroup    String?
  status      TeamStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  trainingSessions TrainingSession[]
  videoAssignments VideoAssignment[]
  announcements    Announcement[]
  squads           Squad[]
  memberships      TeamMembership[]
  staffAssignments StaffAssignment[]
  registrationApplicants PlayerProfile[] @relation("RegistrationApplicant")
}

// TRAINING SESSIONS

model TrainingSession {
  id               Int           @id @default(autoincrement())
  teamId           Int
  team             Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title            String
  notes            String?
  date             DateTime
  startTime        String
  endTime          String
  location         String
  status           SessionStatus @default(SCHEDULED)
  createdByCoachId Int
  createdBy        CoachProfile  @relation("SessionCreatedBy", fields: [createdByCoachId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  attendanceRecords AttendanceRecord[]
  feedback          Feedback[]

  @@index([teamId, date])
}

// ATTENDANCE

model AttendanceRecord {
  id                 Int              @id @default(autoincrement())
  sessionId          Int
  session            TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId           Int
  player             PlayerProfile    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status             AttendanceStatus
  note               String?
  recordedByCoachId  Int
  recordedBy         CoachProfile     @relation("AttendanceRecordedBy", fields: [recordedByCoachId], references: [id])
  recordedAt         DateTime         @default(now())

  @@unique([sessionId, playerId])
  @@index([playerId])
}

// VIDEOS

model Video {
  id               Int           @id @default(autoincrement())
  title            String
  description      String?
  category         VideoCategory
  storageProvider  String        @default("r2")
  /// Object key in the storage bucket — the bucket is always private;
  /// playback URLs are signed on demand via lib/storage.ts's getPlaybackUrl,
  /// never stored, since several free-tier providers gate public bucket
  /// access behind payment info. See lib/storage.ts's file comment.
  key              String
  thumbnailKey     String?
  uploadedByUserId Int
  uploadedBy       User          @relation("VideoUploader", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime      @default(now())

  assignments VideoAssignment[]
}

model VideoAssignment {
  id         Int            @id @default(autoincrement())
  videoId    Int
  video      Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  teamId     Int?
  team       Team?          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId   Int?
  player     PlayerProfile? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  assignedAt DateTime       @default(now())

  @@index([teamId])
  @@index([playerId])
}

// PERFORMANCE

model PerformanceEvaluation {
  id               Int              @id @default(autoincrement())
  playerId         Int
  player           PlayerProfile    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  coachId          Int
  coach            CoachProfile     @relation("EvaluationCoach", fields: [coachId], references: [id])
  periodType       EvaluationPeriod
  periodStart      DateTime
  periodEnd        DateTime
  /// Auto-computed average of this evaluation's category scores — see
  /// ARCHITECTURE.md §6.3. Recomputed whenever category scores change.
  overallScore     Decimal          @db.Decimal(3, 1)
  /// Monthly evaluations only.
  strengths        String?
  /// Monthly evaluations only.
  developmentAreas String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  categoryScores PerformanceCategoryScore[]
  feedback       Feedback[]

  @@index([playerId, periodType, periodStart])
}

model PerformanceCategoryScore {
  id           Int                    @id @default(autoincrement())
  evaluationId Int
  evaluation   PerformanceEvaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  category     PerformanceCategory
  score        Int

  @@unique([evaluationId, category])
}

// FEEDBACK

model Feedback {
  id           Int                     @id @default(autoincrement())
  playerId     Int
  player       PlayerProfile           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  coachId      Int
  coach        CoachProfile            @relation("FeedbackCoach", fields: [coachId], references: [id])
  evaluationId Int?
  evaluation   PerformanceEvaluation?  @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  sessionId    Int?
  session      TrainingSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  message      String
  createdAt    DateTime                @default(now())

  @@index([playerId])
}

// NOTIFICATIONS

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  linkPath  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ANNOUNCEMENTS

model Announcement {
  id           Int               @id @default(autoincrement())
  authorUserId Int
  author       User              @relation("AnnouncementAuthor", fields: [authorUserId], references: [id])
  scope        AnnouncementScope
  teamId       Int?
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title        String
  body         String
  createdAt    DateTime          @default(now())

  @@index([scope, teamId])
}

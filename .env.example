# Locally these can be identical — there's no pooler in front
# of a local Postgres. In production (Vercel), DATABASE_URL
# should be your provider's *pooled* connection string and
# DIRECT_URL the *unpooled* one (used only for migrations).
# e.g. Neon: DATABASE_URL is the "pooled connection", DIRECT_URL
# is the "direct connection" from the same dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/basketball_platform?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/basketball_platform?schema=public"

# Generate your own with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-generated-secret"
# In production, set this to the deployed URL (e.g. your
# Vercel domain) — NextAuth needs it for callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible) — used for video/photo storage.
# See lib/storage.ts. Leave blank locally if you're not testing
# uploads yet; upload endpoints will return a clear error.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Web Push notifications — see lib/push.ts. Generate a keypair once per
# deployment with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY must also be duplicated into NEXT_PUBLIC_VAPID_PUBLIC_KEY
# (same value) since the browser needs it client-side to subscribe.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URI the push services can reach you at if they need to — a
# mailto: link is the usual choice.
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
